{
  "name": "stableflow-ai-sdk",
  "version": "3.0.0",
  "description": "[DEPRECATED] Use @stableflow/* instead. This package is a compatibility shell and will not be maintained.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist", "scripts", "README.md", "LICENSE"],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist node_modules",
    "dev": "tsup --watch",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "pnpm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stableflow-ai/stableflow-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/stableflow-ai/stableflow-ai-sdk/issues"
  },
  "homepage": "https://github.com/stableflow-ai/stableflow-ai-sdk#readme",
  "keywords": [
    "stableflow",
    "ai",
    "sdk",
    "typescript",
    "swap",
    "cross-chain",
    "defi",
    "blockchain",
    "bridge",
    "usdt",
    "ethereum",
    "arbitrum",
    "polygon"
  ],
  "author": "StableFlow AI",
  "license": "MIT",
  "dependencies": {
    "@stableflow/bridges": "latest",
    "@stableflow/core": "latest",
    "@stableflow/hyperliquid": "latest",
    "@stableflow/utils-evm": "latest",
    "@stableflow/utils-solana": "latest",
    "@stableflow/wallet-aptos": "latest",
    "@stableflow/wallet-evm": "latest",
    "@stableflow/wallet-near": "latest",
    "@stableflow/wallet-solana": "latest",
    "@stableflow/wallet-sui": "latest",
    "@stableflow/wallet-ton": "latest",
    "@stableflow/wallet-tron": "latest"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": "^6.3.1",
    "@coral-xyz/anchor": "^0.29.0",
    "@layerzerolabs/lz-solana-sdk-v2": "^3.0.154",
    "@layerzerolabs/lz-ton-sdk-v2": "^3.0.168",
    "@layerzerolabs/lz-v2-utilities": "^3.0.151",
    "@layerzerolabs/oft-v2-solana-sdk": "^3.0.168",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@mysten/sui": "^2.16.2",
    "@near-js/transactions": "^2.5.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@ton/ton": "^16.2.4",
    "axios": "^1.6.8",
    "big.js": "^7.0.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "ethers": "^6.16.0",
    "form-data": "^4.0.0",
    "tronweb": "^6.3.0"
  }
}
